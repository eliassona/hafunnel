{
  "home_assistant": {
    "url": "http://homeassistant.local:8123",
    "token": "PASTE_HOME_ASSISTANT_LONG_LIVED_TOKEN_HERE",
    "verify_tls": true
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8443,
    "tls_cert": "cert.pem",
    "tls_key": "key.pem"
  },
  "client_token_hashes": [
    "PASTE_SHA256_HASH_FROM_gen-token_HERE"
  ],
  "allowed_domains": [
    "sensor", "binary_sensor", "weather", "sun", "climate", "light", "switch",
    "cover", "fan", "input_boolean", "input_number", "input_select", "input_text",
    "humidifier", "media_player", "vacuum", "water_heater", "number", "select"
  ],
  "max_history_days": 7,
  "alerts": {
    "smtp_host": "smtp.example.com",
    "smtp_port": 587,
    "smtp_security": "starttls",
    "smtp_username": "hafunnel@example.com",
    "smtp_password": "PASTE_SMTP_PASSWORD_HERE",
    "from": "hafunnel@example.com",
    "to": ["you@example.com"],
    "max_emails_per_hour": 10,
    "subject_prefix": "[HaFunnel]"
  },
  "access_gate": {
    "alarm_url": "http://alarm.local/status",
    "state_key": "alarm_state",
    "disarmed_value": "DISARMED",
    "night_start": "23:00",
    "night_end": "06:00",
    "timezone": "Europe/Stockholm",
    "timeout_seconds": 5
  }
}
